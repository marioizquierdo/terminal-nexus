{
  "id": "averno",
  "title": "Marshal Averno",
  "notes": "Marshal Averno, the second Commander (commander-armies.md, the mirror), and his campaign. He requires all for the buildings, the shared Nexus powers and the units, and brings his Commander, his own powers and the cards the Ravel Nexus slips into his hand. The same army as Vasse's, pressed forward: his aura makes his units hit harder where hers makes them last, his powers act on the enemy, and some rounds one card of his hand comes from the Ravel Nexus. First versions with no balance claim.",
  "requires": [
    "all"
  ],
  "content": [
    "unit.citizen.averno"
  ],
  "powers": [
    {
      "id": "forward-drill",
      "name": "Forward Drill",
      "description": "Forward Order reaches twice as far.",
      "effect": {
        "modifyCommander": {
          "auraReachTimes": 2
        }
      },
      "rarity": "uncommon",
      "role": "commander",
      "notes": "His skill, wider: the mirror of Vasse's Standing Order, on his aura that presses."
    },
    {
      "id": "unfiled-ordnance",
      "name": "Unfiled Ordnance",
      "description": "Your troopers explode when they die.",
      "effect": {
        "modifyUnit": {
          "unit": "unit.citizen.trooper",
          "detonation": {
            "radius": 2,
            "damage": 8
          }
        }
      },
      "rarity": "uncommon",
      "role": "offense",
      "notes": "Nobody authorized this (commander-armies.md, his few): a power that acts on the enemy through the troopers he spends, the Ravel way of ending, in a Citizen army."
    },
    {
      "id": "raider-contract",
      "name": "Raider Contract",
      "description": "Two Ravel raiders fight for you.",
      "effect": {
        "spawnUnits": {
          "unit": "unit.ravel.raider",
          "count": 2
        }
      },
      "rarity": "uncommon",
      "role": "troops",
      "repeatable": true,
      "from": "ravel",
      "notes": "From the Ravel Nexus, through no channel anyone has filed a form for: two raiders, the raid's own heavy, join at his Nexus and stay."
    },
    {
      "id": "runner-crew",
      "name": "Runner Crew",
      "description": "Four Ravel runners join you.",
      "effect": {
        "spawnUnits": {
          "unit": "unit.ravel.runner",
          "count": 4
        }
      },
      "rarity": "common",
      "role": "troops",
      "repeatable": true,
      "from": "ravel",
      "notes": "From the Ravel Nexus: four quick, fragile runners that burst when they fall."
    }
  ],
  "commanders": [
    {
      "id": "averno",
      "name": "Marshal Averno",
      "unit": "unit.citizen.averno",
      "lean": [
        "units",
        "nexus"
      ],
      "portrait": [
        " _&_ ",
        "(o_-)",
        "/[&]\\"
