      "barks": {
        "appears": [
          "Averno. Forward command.",
          "On the Grid. We move.",
          "Marshal on station. Advance."
        ],
        "restored": [
          "Late. Filed late. Move.",
          "Back. Someone owes me a round.",
          "Restored. Pick up the pace."
        ],
        "round-start": [
          "Forward. No one waits.",
          "Take ground. Then take more.",
          "Advance on my mark. Now."
        ],
        "first-contact": [
          "Contact. Press it.",
          "Hit them first. Hit them hard.",
          "Engage. Do not stop."
        ],
        "raid-arrives": [
          "More targets. Good.",
          "They brought friends. Fine.",
          "Another group. Press them too."
        ],
        "unit-lost": [
          "Step over. Keep moving.",
          "Down one. Forward anyway.",
          "Fill the gap. Push."
        ],
        "building-lost": [
          "We build it further out.",
          "Lost one. Push harder.",
          "Write it off. Advance."
        ],
        "badly-hurt": [
          "Hit. Still forward.",
          "Not yet. Keep pressing.",
          "I can walk. So I advance."
        ],
        "nexus-hit": [
          "They reached the Nexus. Turn.",
          "Off the pyramid. Now.",
          "Back to the Nexus. Then forward."
        ],
        "falls": [
          "Hold the line I gave you.",
          "Back the round after next.",
          "Keep pushing. I'll be back."
        ],
        "round-won": [
          "Round's ours. Forward.",
          "Taken. Log it later.",
          "They broke. Next."
        ]
      },
      "notes": "His unit's definition (his health, his blow, the commander flag, his aura and the round he sits out) is TypeScript in src/content/commanders.ts; this names it, and him. He, his: correct, clipped, a shade too comfortable with what the machine keeps offering him. His glyph is & (the symbol is the identity): a figure with its weight thrown forward, worn on his cap and his chest in his portrait. He leans on units and the Nexus: Forward Order makes the units round him hit harder, and his hand brings Ravel troops some rounds."
    }
  ],
