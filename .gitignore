# Dependencies and build output
node_modules/
dist/
# Anchored to the repository root on purpose. Unanchored, `build/` also matches any directory of
# that name anywhere in the tree — which silently swallowed the whole of `src/build/`, the Build
# Phase module, the first time one existed (Milestone 5 gate 5A). The rule means "build output at
# the root", and now says so.
/build/
coverage/
.cache/
tmp/

# Runtime and environment
.env
.env.*
!.env.example
*.log
*.pid

# Editors and operating systems
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Terminal Nexus evidence artifacts that should remain local unless selected
evidence/local/
captures/local/

# Claude Code background-agent worktrees - ephemeral isolated checkouts, never committed
.claude/worktrees/

