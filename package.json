{
  "name": "terminal-nexus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Terminal Nexus \u2014 the Pulse Playground (Milestone 1, Gate 1A)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "./scripts/check-repository.sh",
    "typecheck": "tsc --noEmit",
    "test": "./scripts/run-tests.sh node",
    "test:bun": "./scripts/run-tests.sh bun",
    "playground": "node bin/playground.ts",
    "play": "./bin/playground.ts watch scenarios/citizens-versus-ravels.ts --glyphs unicode --capability truecolor",
    "play:mono": "./bin/playground.ts watch scenarios/citizens-versus-ravels.ts --capability monochrome",
    "play:cascade": "./bin/playground.ts watch scenarios/ravel-cascade.ts --glyphs unicode --capability truecolor --speed 0.5",
    "play:plain": "./bin/playground.ts watch scenarios/citizens-versus-ravels.ts --no-effects --glyphs unicode --capability truecolor",
    "play:light": "./bin/playground.ts watch scenarios/citizens-versus-ravels.ts --glyphs unicode --capability truecolor --theme light",
    "play:parade": "./bin/playground.ts watch scenarios/speed-parade.ts --glyphs unicode --capability truecolor",
    "play:grand": "./bin/playground.ts watch scenarios/grand-battle.ts --glyphs unicode --capability truecolor",
    "scenarios": "ls scenarios/*.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@opentui/core": "0.5.6"
  }
}
