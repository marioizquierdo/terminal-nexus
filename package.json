{
  "name": "terminal-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terminal Nexus \u2014 an ASCII strategy game for the terminal",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "./scripts/check-repository.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "./scripts/run-tests.sh node",
    "test:bun": "./scripts/run-tests.sh bun",
    "grid": "node bin/grid.ts",
    "duel": "node bin/duel.ts",
    "skirmish": "node bin/skirmish.ts",
    "terminal-nexus": "node bin/terminal-nexus.ts",
    "testing-saves": "ls skirmish-testing/*/*.save.json",
    "trials": "ls skirmish-testing/trials/*.trial.json",
    "test:all": "npm run typecheck && npm test && npm run test:bun",
    "verify-testing-saves": "for save in skirmish-testing/*/*.save.json; do ./bin/grid.ts \"$save\" --verify --runs 20 || exit 1; done"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "gifenc": "1.0.3",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@opentui/core": "0.5.6"
  }
}
